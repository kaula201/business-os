# Database
DATABASE_URL=postgresql+asyncpg://business_os:secret@localhost:5432/business_os
# Application role (business_os_app) password. docker-compose.prod.yml injects
# this from the repo-root .env and refuses to start if it is missing.
# Leave empty for local development — docker-compose.yml does not read it.
APP_DB_PASSWORD=
# Superuser URL for migrate_schema. docker-compose.prod.yml sets this from
# POSTGRES_PASSWORD and unsets it before the API process starts.
# Leave empty for local development (migrations use DATABASE_URL).
MIGRATION_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# Required. The process exits on startup if this is empty or a known placeholder
# (including "jwt-secret-change-me"). Production requires 32+ characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# OpenAI
OPENAI_API_KEY=sk-placeholder-key

# App
APP_NAME=Business OS
# development allows demo seed and open registration.
# production disables both, requires SAAS_WEBHOOK_SECRET, and hides /docs.
APP_ENV=development
# Comma-separated allowlist. Do not use "*".
CORS_ORIGINS=http://localhost:5173

# Payment gateway (Stripe) — optional. When STRIPE_SECRET_KEY is set, real
# charges are attempted; otherwise checkout falls back to sandbox (demo) mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# SaaS billing (TMS standalone subscription model)
# Webhook HMAC-SHA256 signing secret. Required outside development/test/sandbox.
# Header: X-Saas-Signature = hex HMAC-SHA256 of the raw body.
SAAS_WEBHOOK_SECRET=
# Daily billing scheduler (expire lapsed trials, bill due active subs).
SAAS_BILLING_AUTO_ENABLED=true
SAAS_BILLING_HOUR=3
SAAS_BILLING_MINUTE=0
SAAS_BILLING_TIMEZONE=Asia/Tbilisi

# Optional host allowlist for outbound integration webhooks.
WEBHOOK_URL_ALLOWLIST=
