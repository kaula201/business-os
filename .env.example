# Production Docker Compose (docker-compose.prod.yml).
# Required: Compose refuses to start if either value is missing or empty.
# Use two different strong passwords. APP_DB_PASSWORD is placed in DATABASE_URL,
# so do not use @ : / # ? or spaces.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# % is allowed. Do not use @ : / # ? or spaces — both values are embedded in URLs.
# Compose builds MIGRATION_DATABASE_URL from POSTGRES_PASSWORD for migrations only.
POSTGRES_PASSWORD=change-me-strong-password
APP_DB_PASSWORD=change-me-app-db-password

# Database
DATABASE_URL=postgresql+asyncpg://business_os:secret@postgres:5432/business_os
DATABASE_URL_SYNC=postgresql://business_os:secret@postgres:5432/business_os

# Redis
REDIS_URL=redis://redis:6379/0

# Security
# JWT signing key. The API refuses to start if this is empty or a known placeholder.
# Production (APP_ENV=production) requires at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# App
APP_NAME=Business OS
# development | production. Production disables demo seed, open registration,
# unsigned SaaS webhooks, and /docs.
APP_ENV=development
# Explicit browser origins. Wildcard "*" is rejected.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SaaS billing webhook HMAC secret. Required when APP_ENV is not development/test/sandbox.
SAAS_WEBHOOK_SECRET=

# Optional comma-separated host allowlist for outbound webhooks.
# Private, link-local, and metadata addresses are blocked even when this is empty.
WEBHOOK_URL_ALLOWLIST=
